{% set upcomingFestival = festivals | findBySlug("melbourne-international-dumpling-festival-2026") %}
{% set momoFestival = festivals | findBySlug("momo-fest-melbourne-2026") %}
<footer class="footer" aria-label="Site footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="word">ICCL <em>·</em></div>
      <p>{{ footer_blurb | default("Inhale Culture Celebrate Life Ltd is a registered Australian charity and public company limited by guarantee, advancing culture through multicultural arts, food and community programming.") | safe }}</p>
    </div>
    <div>
      <h2 class="footer-heading">Navigate</h2>
      <ul>
        <li><a href="{{ '/' | url }}">Home</a></li>
        <li><a href="{{ '/festivals/' | url }}">Festivals</a></li>
        <li><a href="{{ '/about.html' | url }}">About ICCL</a></li>
        <li><a href="{{ '/about.html#governance' | url }}">Governance</a></li>
        <li><a href="{{ '/about.html#contact' | url }}">Contact</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer-heading">Our festivals</h2>
      <ul>
        <li><a href="{{ ('/festivals/#' ~ upcomingFestival.slug) | url }}">{{ upcomingFestival.name }}</a></li>
        <li><a href="{{ momoFestival.detailPath | url }}">{{ momoFestival.name }}</a></li>
        {% if momoFestival.siteUrl %}
        <li><a href="{{ momoFestival.siteUrl }}" target="_blank" rel="noopener noreferrer">MOMO Fest website <span class="sr-only">(opens in a new tab)</span></a></li>
        {% endif %}
      </ul>
    </div>
    <div>
      <h2 class="footer-heading">Follow</h2>
      <ul>
        <li><a href="https://www.facebook.com/iccl.org.au" target="_blank" rel="noopener noreferrer">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span>{{ footer_legal | default("© 2026 Inhale Culture Celebrate Life Ltd · ABN 94 690 672 694 · ACN 690 672 694") }}</span>
    <span>Registered charity · Thornbury VIC 3071</span>
  </div>
</footer>
