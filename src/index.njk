---
permalink: index.html
canonical_path: /
title: ICCL — Inhale Culture, Celebrate Life
description: Inhale Culture Celebrate Life Ltd is a registered Australian charity creating public festivals and cultural experiences that bring communities together.
og_title: ICCL — Inhale Culture, Celebrate Life
og_description: A registered Australian charity creating public festivals and cultural experiences that bring communities together.
og_type: website
currentPage: home
sitemap_priority: "1.0"
---
{% extends "base.njk" %}

{% set upcomingFestival = festivals | findBySlug("melbourne-international-dumpling-festival-2026") %}

{% block jsonld %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "{{ canonical_url }}#webpage",
  "url": "{{ canonical_url }}",
  "name": "{{ title }}",
  "description": "{{ description }}",
  "isPartOf": { "@id": "{{ organization_url }}#website" },
  "about": { "@id": "{{ organization_url }}#organization" },
  "primaryImageOfPage": {
    "@type": "ImageObject",
    "url": "{{ site.url }}{{ '/assets/Hero-image.jpg' | url }}",
    "caption": "ICCL organisers and volunteers on stage at MOMO Fest Melbourne 2026"
  },
  "inLanguage": "en-AU"
}
</script>
{% endblock %}

{% block content %}
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Inhale Culture Celebrate Life Ltd · est. 2025</p>
        <h1>Inhale<br>culture.<br><em>Celebrate life.</em></h1>
        <p class="hero-sub">ICCL is a registered Australian charity creating public festivals and cultural experiences that bring communities together through food, music, performance and shared celebration.</p>
        <div class="hero-actions">
          <a href="{{ '/festivals/' | url }}" class="btn btn-primary">Explore our festivals <span class="ar" aria-hidden="true">→</span></a>
          <a href="{{ '/about.html' | url }}" class="btn btn-ghost">About ICCL</a>
        </div>
      </div>

      <div class="hero-media">
        {% responsiveImage "/assets/Hero-image.jpg", "ICCL organisers and volunteers on stage at MOMO Fest Melbourne 2026", "(max-width: 920px) 100vw, 48vw", "hero-photo", "eager", "high" %}
        <span class="hero-tag">ICCL · Festivals &amp; cultural programs</span>
      </div>
    </div>

    <div class="hero-meta" aria-label="ICCL organisation details">
      <dl class="hero-meta-inner">
        <div>
          <dt>Founded</dt>
          <dd>September 2025</dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>Thornbury, Victoria</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>Registered charity</dd>
        </div>
        <div>
          <dt>Coming next</dt>
          <dd>{{ upcomingFestival.name }} · November 2026</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section festival-portfolio festival-portfolio--home" id="upcoming-festival" aria-labelledby="festival-heading">
    <div class="section-head section-head--feature">
      <div>
        <p class="eyebrow">Upcoming festival · November 2026</p>
        <h2 id="festival-heading">Our <em>festivals.</em></h2>
      </div>
      <p class="lede">ICCL presents distinct public festivals under their own identities, bringing communities together through food, performance and shared cultural experience.</p>
    </div>

    <div class="festival-list">
      {% for festival in festivals %}
        {% include "festival-card.njk" %}
      {% endfor %}
    </div>
  </section>

  <section class="section work" aria-labelledby="work-heading">
    <div class="plain-section-head">
      <p class="section-label">What ICCL does</p>
      <h2 id="work-heading" class="section-title-plain">Cultural experiences with a public purpose.</h2>
      <p class="lede">ICCL’s work extends beyond any single festival. We create credible, welcoming settings for cultural exchange, participation and belonging.</p>
    </div>

    <div class="work-grid work-grid--asymmetric">
      <article class="work-item">
        <span class="work-num">01</span>
        <h3>Festivals and public events</h3>
        <p>ICCL creates welcoming public festivals that bring food, music, performance and cultural participation into shared community spaces.</p>
      </article>
      <article class="work-item">
        <span class="work-num">02</span>
        <h3>Multicultural community</h3>
        <p>We connect communities through shared experiences that encourage cultural exchange, participation and belonging.</p>
      </article>
      <article class="work-item">
        <span class="work-num">03</span>
        <h3>Arts, food and heritage</h3>
        <p>We provide platforms for artists, cooks, performers and cultural practitioners to share living traditions with wider audiences.</p>
      </article>
    </div>
  </section>

  <section class="quote" aria-labelledby="object-heading">
    <div class="quote-inner">
      <p class="section-label section-label--light">Our principal object</p>
      <h2 id="object-heading" class="sr-only">ICCL’s principal constitutional object</h2>
      <blockquote>
        To advance culture in Australia by curating, producing and presenting festivals, events and programs with a focus on arts, culture and heritage representing multicultural Australia — while fostering intercultural understanding and social cohesion.
      </blockquote>
      <div class="quote-attr">Constitution of Inhale Culture Celebrate Life Ltd · Adopted 27 August 2025</div>
    </div>
  </section>

  <section class="contact-strip" aria-labelledby="contact-heading">
    <div class="contact-grid">
      <div>
        <p class="section-label">Partnership and enquiries</p>
        <h2 id="contact-heading" class="section-title-plain">Work with ICCL.</h2>
        <p class="lede contact-intro">For sponsorship, partnership, media or general enquiries, contact our volunteer-led team.</p>
        <div class="hero-actions">
          <a href="{{ '/about.html#contact' | url }}" class="btn btn-primary">Contact ICCL <span class="ar" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div>
        <div class="label">Registered office</div>
        <address>
          Inhale Culture Celebrate Life Ltd<br>
          302 St Georges Road<br>
          Thornbury VIC 3071<br>
          Australia
        </address>
      </div>
      <div>
        <div class="label">Email</div>
        <div class="email-list">
          <div class="row">
            <span class="key">General</span>
            <a href="mailto:info@iccl.org.au">info@iccl.org.au</a>
          </div>
          <div class="row">
            <span class="key">Events</span>
            <a href="mailto:events@iccl.org.au">events@iccl.org.au</a>
          </div>
        </div>
        <div class="label contact-online-label">Online</div>
        <p class="contact-online">
          <a href="https://www.facebook.com/iccl.org.au" class="linky" target="_blank" rel="noopener noreferrer">ICCL on Facebook <span class="sr-only">(opens in a new tab)</span></a>
        </p>
      </div>
    </div>
  </section>
{% endblock %}
